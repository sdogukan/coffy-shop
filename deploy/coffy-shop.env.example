# Coffy Shop runtime environment (systemd EnvironmentFile syntax: NAME=value,
# no quotes needed). provision.sh installs this file as
# /etc/coffy-shop/coffy-shop.env (root:coffy-shop 0640) only when it is absent.
# Fill in every value on the server; never commit a filled-in copy.
# deploy/README.md describes each variable.
NODE_ENV=
HOSTNAME=
PORT=
COFFY_DATABASE_PATH=
COFFY_RELEASE_ENVIRONMENT=
COFFY_ADMIN_USERNAME=
COFFY_ADMIN_PASSWORD_HASH=
